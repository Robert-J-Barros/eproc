# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env (já está no .gitignore).

# URL base do e-Proc do tribunal desejado. O login detecta sozinho o
# fluxo certo (Keycloak/SSO ou formulário nativo) -- não precisa
# configurar qual tribunal é. Confirmado com TJRS e TJTO; TJRO deve
# funcionar pelo mesmo mecanismo.
EPROC_URL=https://eproc1g.tjrs.jus.br
EPROC_USUARIO=seu_usuario_aqui
EPROC_SENHA=sua_senha_aqui

# Chave secreta do app autenticador (TOTP), formato Base32.
# Veja README.md -> seção "MFA / código rotativo" para como obter,
# inclusive usando o decode_qr.py incluso neste projeto.
EPROC_TOTP_SECRET=sua_chave_totp_aqui

# Nome da parte a pesquisar. Use espaços normalmente (ex.: "AGRO CENTER
# LTDA") -- não codifique manualmente, o script cuida disso.
EPROC_NOME_DA_PARTE=NOME AQUI

# true = roda em segundo plano (sem janela visível)
# false = abre o navegador visível (útil para depurar seletores)
EPROC_HEADLESS=true

# --- Resolução de CAPTCHA (opcional, evento raro no e-Proc) ---
# Chave de API da NopeCHA (https://nopecha.com). Usada SOMENTE se um
# captcha (ex.: Cloudflare Turnstile) aparecer em alguma tela -- login,
# consulta, paginação, etc. Deixe vazia se você não tem uma chave; o
# fluxo normal roda 100% igual e sem custo nenhum. Só falha se um
# captcha REALMENTE aparecer e esta chave não estiver configurada.
EPROC_NOPECHA_API_KEY=

# --- Banco de dados (MySQL/MariaDB) ---
# Container PRÓPRIO desta pasta (serviço "mysql" no docker-compose.yaml
# ao lado, com volume nomeado só do TJRS) -- banco 100% independente
# dos outros tribunais, não mais o MySQL nativo da sua máquina.
# Acessível também via localhost:3306 no seu computador (porta
# publicada), para inspecionar com um client externo (DBeaver, MySQL
# Workbench, etc.) -- cada tribunal usa uma porta de host diferente
# (TJRS=3306, TJRO=3307, TJTO=3308) para poder rodar todos ao mesmo
# tempo sem colidir.
MYSQL_ROOT_PASSWORD=troque_essa_senha
MYSQL_DATABASE=eproc_tjrs
MYSQL_USER=eproc
MYSQL_PASSWORD=troque_essa_senha_tambem

# MYSQL_HOST=mysql -- nome do serviço no docker-compose.yaml; a
# comunicação entre o container do crawler e o do MySQL usa a rede
# interna do Docker (DNS automático pelo nome do serviço), não
# localhost nem host.docker.internal.
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Varredura em massa (crawler.py) ---

# Termos de busca genéricos em "Nome da Parte", separados por vírgula.
# O crawler itera um por um, varrendo todas as empresas encontradas.
# O e-Proc exige pelo menos 2 palavras no campo "Nome da Parte"
# (confirmado: termo isolado como "LTDA" é rejeitado com o alerta
# "Informe um nome para consulta com pelo menos duas partículas").
# Por isso os termos de busca são gerados combinando palavras comuns
# com os sufixos societários (CRAWLER_AUTOR_SUFIXOS, abaixo) --
# produto cartesiano. Ex.: "COMERCIO LTDA", "COMERCIO EIRELI",
# "SERVICOS LTDA", "SERVICOS EIRELI", etc.
# --- Estratégia principal: divisão de UMA palavra em 2 "partículas" ---
# Técnica: divide uma palavra ampla (ex.: COMERCIO) em duas metades com
# espaço no meio (ex.: "Comer cio"), satisfazendo a exigência de 2
# palavras do e-Proc, mas na prática ainda buscando o termo único --
# qualquer parte com "COMERCIO" no nome ainda bate, já que ambas as
# metades aparecem juntas nesse trecho do nome. "Comer cio" e
# "Indus tria" deram os maiores volumes de resultado nos testes.
CRAWLER_TERMOS_BUSCA_EXTRA=/app/crawler_config/termos.txt

# Alternativa para listas grandes (ex.: todos os prefixos de 2 letras +
# "Metalur Gica") que ficariam ilegíveis numa única linha de vírgulas:
# em vez da lista, coloque aqui o CAMINHO de um arquivo texto com um
# termo de busca por linha (linhas em branco ou começando com '#' são
# ignoradas) -- é detectado automaticamente (se o valor for um arquivo
# que existe, lê de lá; senão, trata como lista separada por vírgula).
# Como o crawler roda dentro de um container Docker, o arquivo precisa
# estar num caminho montado como volume -- por padrão o
# docker-compose.yaml monta ./crawler_config (no host) em
# /app/crawler_config (no container), então salve o arquivo em
# ./crawler_config/termos_extra.txt e use o caminho abaixo. Exemplo:
# CRAWLER_TERMOS_BUSCA_EXTRA=/app/crawler_config/termos_extra.txt

# --- Estratégia alternativa/complementar: palavra + sufixo societário ---
# Combina cada palavra abaixo com LTDA/EIRELI (CRAWLER_AUTOR_SUFIXOS),
# gerando termos como "SERVICOS LTDA". Deixe vazio para não usar essa
# estratégia (a de cima já cobre bem mais volume).
CRAWLER_PALAVRAS_BASE=

# Filtro: autor deve conter um destes termos (mesma lista normalmente)
CRAWLER_AUTOR_SUFIXOS=LTDA,EIRELI

# Filtro: réu NÃO pode conter nenhum destes termos (case-insensitive)
CRAWLER_REU_IGNORAR=BANCO,COOPERATIVA,MUNICIPIO,MUNICÍPIO,ESTADO

# Filtro: intervalo de data de autuação (formato AAAA-MM-DD)
CRAWLER_DATA_INICIO=2018-01-01
CRAWLER_DATA_FIM=2025-08-30

# Filtro: intervalo de valor da causa (em reais, sem formatação)
CRAWLER_VALOR_MIN=5000.00
CRAWLER_VALOR_MAX=350000.00

# Filtro: UF da OAB do advogado
CRAWLER_OAB_UF=RS

# Pausa (segundos) antes de CADA ação que bate no servidor do e-Proc
# (clicar em Consultar, virar página, abrir empresa, abrir processo) --
# evita sobrecarregar o site. Aumente se quiser ainda mais devagar.
CRAWLER_DELAY_ENTRE_REQUISICOES_SEGUNDOS=5

# Intervalo (segundos) entre ciclos completos do loop contínuo, depois
# de esgotar todos os termos/empresas -- evita ficar martelando o
# servidor sem necessidade quando não há nada novo para processar.
CRAWLER_INTERVALO_CICLO_SEGUNDOS=3600
